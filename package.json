{
  "name": "@origozero/zeromind",
  "version": "0.8.0",
  "description": "Use Zero worlds from your agent's shell or MCP connector. Agent login, native engine installation, headless rendering, branch selection and remote shell execution.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zeromind": "dist/index.js",
    "zero": "dist/index.js",
    "zero-shell": "dist/shell.js"
  },
  "files": [
    "dist/",
    "skills/",
    "templates/",
    "dist-publishing/",
    "docs/install-matrix.json",
    "docs/install-matrix.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tools tests --ext .ts --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.ts\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "undici": "^6.0.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://origozero.ai/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/OrigoZero/zeromind-plugin.git"
  },
  "license": "MIT",
  "keywords": [
    "zeromind",
    "mcp",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "opencode",
    "cline",
    "continue",
    "windsurf",
    "zed",
    "origozero",
    "zero-engine"
  ]
}
